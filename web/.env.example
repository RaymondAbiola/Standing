# Contract addresses are NOT set here. They live in lib/deployments.ts, keyed by
# chain id, because the same address holds different contracts on different
# chains: Standing on Arbitrum Sepolia shares an address with the faucet token
# on Robinhood testnet. One env var would happily read one as the other.

# Everything below is optional. Each has a working public default, so the app
# builds and runs with no env file at all, which is how it is deployed.
#
# Set one only to escape a rate limit or an outage. The NEXT_PUBLIC_ prefix is
# required: without it Next.js keeps the value on the server, and the browser,
# which is what actually makes these calls, never sees it.
#
# These are NOT the Foundry variables. The repo root .env.example holds those
# (ARBITRUM_SEPOLIA_RPC_URL and friends) and they are read by forge, not here.

# NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC=
# NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC=

# Robinhood mainnet. Nothing is deployed there, so this is unused for now.
# NEXT_PUBLIC_ROBINHOOD_RPC=
